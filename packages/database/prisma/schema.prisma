generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Settings {
  id             Int      @id @default(1)
  smtpHost       String?
  smtpPort       String?
  smtpEncryption String?
  smtpUsername   String? // SMTP auth login - many providers (incl. SMTP2GO) use an account/domain handle here, NOT a valid email address, so it must not be reused as the "From" sender
  smtpPassword   String?
  smtpFromEmail  String? // actual "From" sender address - separate from smtpUsername on purpose, see above
  smtpFromName   String? // optional display name, e.g. "Venture27 Notifications"
  openaiKey      String?
  anthropicKey   String?
  geminiKey      String?
  // Last-used Generate Content settings, saved explicitly via its own "Save
  // Settings" button (not auto-persisted) so a page refresh doesn't force
  // re-entering the prompt/model/notify-email every time.
  defaultPromptTemplate String?
  defaultAiModel        String?
  defaultNotifyEmail    String?
  defaultEnableSmtp     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Category {
  id        Int          @id @default(autoincrement())
  name      String       @unique
  data      MasterData[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Location {
  id        Int          @id @default(autoincrement())
  city      String?
  community String?
  county    String?
  province  String
  data      MasterData[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([city, community, county, province])
}

model Service {
  id              Int          @id @default(autoincrement())
  name            String
  metaTitle       String?
  metaDescription String?
  heading         String?
  subheading      String?
  data            MasterData[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([name])
}

model MasterData {
  id         Int      @id @default(autoincrement())
  categoryId Int
  locationId Int
  serviceId  Int
  content    String?
  image      String?
  status     String   @default("pending") // pending, generated, error
  errorMessage String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  slug        String?   @unique

  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([categoryId, locationId, serviceId])
}

model PromptTemplate {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Job {
  id             Int      @id @default(autoincrement())
  status         String   @default("running") // running, paused, stopped, completed
  progress       Int      @default(0)
  totalItems     Int      @default(0)
  generatedCount Int      @default(0)
  errorCount     Int      @default(0)
  errorLogs      String?
  notifyEmail    String? // recipient for the completion/failure summary email, if the user opted in for this run
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
