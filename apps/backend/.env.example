# Local dev only - loaded via `dotenv/config` at backend startup (see
# src/index.ts). In production these are already exported by the container's
# shell (deploy/entrypoint.sh, from deploy/.env) so this file isn't used
# there. Must match apps/frontend/.env.example's values exactly - both apps
# need the same DASHBOARD_USERNAME/PASSWORD/SESSION_SECRET since login now
# happens here but session verification still happens in the frontend's
# proxy.ts.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
SESSION_SECRET=
