# Username + password required to log into the admin dashboard (the /login
# page). Public programmatic pages (/{type}/services/...) and SEO files
# (robots.txt, sitemaps) stay reachable without this - only the admin
# dashboard + its API routes are gated.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# Signs the login session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Absolute URL of this deployment - used for canonical/OG links and the
# sitemap. Defaults to http://localhost:3000 if unset.
SITE_URL=
