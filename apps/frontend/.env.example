# Signs/verifies the login session cookie (proxy.ts checks it here; the
# actual login endpoint that issues it now lives in apps/backend - see
# apps/backend/.env.example). Must be the exact same value in both apps'
# env files, or tokens the backend signs won't verify here.
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Absolute URL of this deployment - used for canonical/OG links and the
# sitemap. Defaults to http://localhost:3000 if unset.
SITE_URL=
