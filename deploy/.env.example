# Runtime secrets for the single-container deployment (deploy/entrypoint.sh).
# Copy to deploy/.env on the server (never commit the filled-in version) and
# pass it to the container with `docker run --env-file deploy/.env ...`.

# Internal PostgreSQL superuser password (container-local only, not exposed
# outside the container - pick any strong random value).
POSTGRES_PASSWORD=

# Dashboard login (apps/frontend/app/login) - separate from the nginx Basic
# Auth layer in front of the whole subdomain.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# Signs the dashboard session cookie (jose HS256). Generate with:
#   openssl rand -base64 32
SESSION_SECRET=

# Public URL of the deployed site, used for sitemap/canonical links.
SITE_URL=https://programmatic-pages.venture27.com
